pipeline {
    agent any

    environment {
        DOCKER_IMAGE = 'engkipngetich/week9-node-app'
        DOCKER_CREDENTIALS = 'dockerhub-credentials'
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Source code has been checked out by Jenkins.'
            }
        }

        stage('Build') {
            steps {
                dir('node-app') {
                    echo 'Installing Node.js dependencies...'
                    sh 'npm ci'
                }
            }
        }

        stage('Test') {
            steps {
                dir('node-app') {
                    echo 'Running automated tests...'
                    sh 'npm test'
                }
            }
        }

        stage('Validation') {
            steps {
                dir('node-app') {
                    echo 'Validating application syntax...'
                    sh 'node --check server.js'
                    sh 'node --check test.js'
                    echo 'Validation completed successfully!'
                }
            }
        }

        stage('Package') {
            steps {
                echo 'Creating application package...'
                sh '''
                    rm -f application.tar.gz

                    tar -czf application.tar.gz \
                    --exclude=node_modules \
                    --exclude=.git \
                    -C node-app .
                '''

                echo 'Application package created successfully.'
            }
        }

        stage('Docker Build') {
            steps {
                dir('node-app') {
                    echo 'Building Docker image...'

                    sh '''
                        docker build \
                        -t ${DOCKER_IMAGE}:${BUILD_NUMBER} \
                        -t ${DOCKER_IMAGE}:latest \
                        .
                    '''
                }
            }
        }

        stage('Docker Push') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: "${DOCKER_CREDENTIALS}",
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''
                        echo "$DOCKER_PASSWORD" | docker login \
                        --username "$DOCKER_USER" \
                        --password-stdin

                        docker push ${DOCKER_IMAGE}:${BUILD_NUMBER}
                        docker push ${DOCKER_IMAGE}:latest

                        docker logout
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'CI pipeline and Docker image publication completed successfully.'
        }

        failure {
            echo 'Pipeline failed. Check the Console Output for details.'
        }

        always {
            echo "Build number: ${BUILD_NUMBER}"
        }
    }
}
